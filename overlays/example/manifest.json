{
  "manifestVersion": 1,
  "name": "Exemple",
  "description": "Pack de démonstration du SDK : session et score en direct. Sert de modèle pour créer un overlay.",
  "author": "THEVBAT",
  "version": "1.0.0",
  "modules": [
    {
      "id": "session",
      "name": "Barre de session",
      "description": "Victoires, défaites, série et score du match en cours",
      "category": "session",
      "entry": "modules/session.html",
      "size": { "width": 420, "height": 56 },
      "defaultPosition": { "anchor": "top-right", "x": 20, "y": 20 },
      "data": ["session", "match", "connection"],
      "settings": [
        {
          "key": "showScore",
          "type": "boolean",
          "label": "Afficher le score du match",
          "default": true
        },
        {
          "key": "winColor",
          "type": "color",
          "label": "Couleur des victoires",
          "default": "#4cdb8a"
        },
        {
          "key": "bgOpacity",
          "type": "range",
          "label": "Opacité du fond",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "unit": "%",
          "default": 0.85
        }
      ]
    }
  ]
}
